envSaveStack8mBAnim=mean(nonZeroElements);

upperTriangular = triu(correlationMatrix9, 1);
nonZeroElements = upperTriangular(upperTriangular ~= 0);
envSaveStack9mBAnim=mean(nonZeroElements);

