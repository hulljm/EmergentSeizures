% poly order 1
%real part
for i=1:nVars
    str1='y('; %changed to *-1
    %iShift=i*2-1;
    str2=num2str((i*2-1)) ;
    str3=')';
    %str3=')*3.188287';
    if regMed>0
    %str3=')/62.54224491';
    str3=')/230';
    end
    %str3=')*1';
    %str3=')';
    strOut=append(str1,str2,str3);
    yout(ind,1) = yin(i);
    youtBuilder{ind,1}=[strOut];
    ind = ind+1;
end

%imag part
for i=1:nVars
    str1='y('; %changed to *-1
    %iShift=i*2-1;
    str2=num2str((i*2)) ;
    str3=')';
    %str3=')*3.188287';
    if regMed>0
    %str3=')/62.55074337';
    str3=')/230';
    end
    %str3=')*1';
    %str3=')';
    strOut=append(str1,str2,str3);
    yout(ind,1) = yin(i);
    youtBuilder{ind,1}=[strOut];
    ind = ind+1;
end


