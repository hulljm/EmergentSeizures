if(polyorder>=3)
    for m=1:nVars
        if m == 1 || m == 3 || m == 5 || m == 7 ||m == 9 || m == 11
            R1=num1; %Fr
            R2=num2; %Back
        end
        if m == 2 || m == 4 || m == 6 || m == 8 ||m == 10 || m == 12
            R1=num3; %Fr
            R2=num4; %Back
        end
                yout(:,ind) = 1./(1*abs(yin2(:,R1)+1i*yin3(:,R1)).^normFactor+1).*(yin2(:,R1)).*yin2(:,R2)/1976.45;  
          ind = ind+1;
    end
end