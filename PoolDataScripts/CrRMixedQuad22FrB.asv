%%%%%%%%%%%%%%%%%%mixed quad across regions Fr B L, 1:1
normFactor=2;
num1=1;
num2=3;
num3=2;
num4=4;


if(polyorder>=3)
    for m=1:nVars
        if m == 1 || m == 3 || m == 5 || m == 7 ||m == 9 || m == 11
            R1=1; %Fr
            R2=3; %Back
        end
        if m == 2 || m == 4 || m == 6 || m == 8 ||m == 10 || m == 12
            R1=2; %Fr
            R2=4; %Back
        end
                yout(:,ind) = 1./(1*abs(yin2(:,R1)+1i*yin3(:,R1)).^normFactor+1).*(yin2(:,R1)).*yin2(:,R2)/1976.45;  
          ind = ind+1;
    end
end

